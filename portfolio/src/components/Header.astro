---
import { ROUTES } from "../lib/consts";
import { getSnapshot, getSettings } from "../lib/portfolio";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isMain = path === "/";
const isActive = (href: string) =>
    path === href || path.startsWith(href + "/");
const { categories } = await getSnapshot();
const settings = await getSettings();
---

<header
    class:list={["app-header", { "is-main": isMain }]}
    style={`--header-color: ${settings.mainHeaderColor}`}
>
    <div class="header-content">
        <a href={ROUTES.main} class="logo" aria-label="Home">
            <img src="/img/logoWhite.svg" alt="" class="logo-img logo-light" />
            <img src="/img/logoBlack.svg" alt="" class="logo-img logo-dark" />
        </a>

        <nav class="desktop-nav" aria-label="Primary">
            <ul>
                {
                    categories.map((c) => (
                        <li>
                            <a
                                href={`/portfolio/${c.slug}`}
                                class:list={[
                                    "text-uppercase",
                                    "text-hover",
                                    {
                                        active: isActive(
                                            `/portfolio/${c.slug}`,
                                        ),
                                    },
                                ]}
                            >
                                {c.name}
                            </a>
                        </li>
                    ))
                }
                <li>
                    <a
                        href={ROUTES.about}
                        class:list={[
                            "text-uppercase",
                            "text-hover",
                            { active: isActive(ROUTES.about) },
                        ]}
                    >
                        About me
                    </a>
                </li>
                <li>
                    <a
                        href={ROUTES.price}
                        class:list={[
                            "text-uppercase",
                            "text-hover",
                            { active: isActive(ROUTES.price) },
                        ]}
                    >
                        Price
                    </a>
                </li>
            </ul>
        </nav>

        <a
            href={settings.instLink}
            target="_blank"
            rel="noopener"
            class="inst-link text-hover"
        >
            inst →
        </a>

        <button
            class="burger-btn"
            type="button"
            aria-label="Toggle menu"
            aria-expanded="false"
        >
            <span></span><span></span><span></span>
        </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile">
        <ul class="primary">
            {
                categories.map((c) => (
                    <li>
                        <a
                            href={`/portfolio/${c.slug}`}
                            class:list={[
                                "text-uppercase",
                                "text-hover",
                                {
                                    active: isActive(
                                        `/portfolio/${c.slug}`,
                                    ),
                                },
                            ]}
                        >
                            {c.name}
                        </a>
                    </li>
                ))
            }
            <li>
                <a
                    href={ROUTES.about}
                    class:list={[
                        "text-uppercase",
                        "text-hover",
                        { active: isActive(ROUTES.about) },
                    ]}
                >
                    About me
                </a>
            </li>
            <li>
                <a
                    href={ROUTES.price}
                    class:list={[
                        "text-uppercase",
                        "text-hover",
                        { active: isActive(ROUTES.price) },
                    ]}
                >
                    Price
                </a>
            </li>
        </ul>
        <a
            href={settings.instLink}
            target="_blank"
            rel="noopener"
            class="text-hover"
        >
            inst →
        </a>
    </nav>
</header>

<script>
    function bindBurger() {
        const header = document.querySelector<HTMLElement>("header.app-header");
        if (!header || header.dataset.bound === "1") return;
        header.dataset.bound = "1";

        const btn = header.querySelector<HTMLButtonElement>(".burger-btn");
        const close = () => {
            header.classList.remove("is-open");
            btn?.setAttribute("aria-expanded", "false");
        };

        btn?.addEventListener("click", () => {
            const open = header.classList.toggle("is-open");
            btn.setAttribute("aria-expanded", open ? "true" : "false");
        });

        header.querySelectorAll(".mobile-nav a").forEach((link) => {
            link.addEventListener("click", close);
        });
    }

    function updateActiveNav() {
        const path =
            location.pathname.replace(/\/$/, "") || "/";
        document
            .querySelectorAll<HTMLAnchorElement>(".desktop-nav a, .mobile-nav a.text-uppercase")
            .forEach((a) => {
                const href = a.getAttribute("href") || "";
                const isActive =
                    path === href || path.startsWith(href + "/");
                a.classList.toggle("active", isActive);
            });
    }

    function updateHeaderScroll() {
        const header = document.querySelector<HTMLElement>("header.app-header");
        if (!header || header.classList.contains("is-open")) return;

        const hero = document.querySelector<HTMLElement>(".hero");
        if (!hero) {
            header.classList.remove("is-scrolled");
            return;
        }

        const heroBottom = hero.getBoundingClientRect().bottom;
        const headerCenter = header.getBoundingClientRect().height / 2;
        header.classList.toggle("is-scrolled", heroBottom <= headerCenter);
    }

    bindBurger();
    updateActiveNav();
    updateHeaderScroll();
    window.addEventListener("scroll", updateHeaderScroll, { passive: true });
    window.addEventListener("resize", updateHeaderScroll, { passive: true });
    document.addEventListener("astro:page-load", () => {
        bindBurger();
        updateActiveNav();
        updateHeaderScroll();
    });
</script>

<style>
    .app-header {
        width: 100%;
        height: var(--header-height);
        padding: 45px;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        background-color: transparent;
        backdrop-filter: blur(10px);
        z-index: 10;
        overflow: hidden;
        color: var(--secondary-color);
        transition:
            height 0.5s ease-in-out,
            background-color 0.5s ease-in-out,
            color 0.15s ease-in-out;
    }
    .app-header.is-main {
        color: var(--header-color, var(--primary-color));
    }
    .app-header.is-main.is-scrolled {
        color: var(--secondary-color);
    }

    .header-content {
        width: 100%;
        max-width: var(--max-content-width);
        display: flex;
        align-items: center;
    }

    .logo {
        flex: 1 1 0;
        display: inline-grid;
        justify-items: start;
        align-items: center;
    }
    .logo-img {
        grid-area: 1 / 1;
        transition: opacity 0.15s ease-in-out;
    }
    .logo-light {
        opacity: 0;
    }
    .logo-dark {
        opacity: 1;
    }
    .app-header.is-main:not(.is-open) .logo-light {
        opacity: 1;
    }
    .app-header.is-main:not(.is-open) .logo-dark {
        opacity: 0;
    }
    .app-header.is-main.is-scrolled:not(.is-open) .logo-light {
        opacity: 0;
    }
    .app-header.is-main.is-scrolled:not(.is-open) .logo-dark {
        opacity: 1;
    }

    .desktop-nav {
        flex: 0 1 auto;
        display: flex;
        justify-content: center;
    }
    .desktop-nav ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 30px;
    }
    .desktop-nav a {
        color: inherit;
    }
    .desktop-nav a.active,
    .mobile-nav a.active {
        color: var(--accent-color);
    }
    .inst-link {
        flex: 1 1 0;
        display: flex;
        justify-content: flex-end;
        white-space: nowrap;
    }

    .burger-btn {
        display: none;
        width: 30px;
        height: 24px;
        flex-direction: column;
        justify-content: space-between;
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        color: inherit;
    }
    .burger-btn span {
        display: block;
        width: 100%;
        height: 1.5px;
        background-color: currentColor;
        transition: all 0.3s ease-in-out;
    }
    .app-header.is-open .burger-btn span:nth-child(1) {
        transform: translateY(11.25px) rotate(45deg);
    }
    .app-header.is-open .burger-btn span:nth-child(2) {
        opacity: 0;
    }
    .app-header.is-open .burger-btn span:nth-child(3) {
        transform: translateY(-11.25px) rotate(-45deg);
    }

    .mobile-nav {
        display: none;
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
        max-width: 600px;
        gap: 30px;
        padding-top: 40px;
        padding-bottom: 40px;
        margin: 0 auto;
        flex: 1;
    }
    .mobile-nav .primary {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
        width: 100%;
    }
    .mobile-nav a {
        color: inherit;
    }
    .mobile-nav > a {
        margin-top: auto;
        align-self: center;
    }

    .app-header.is-open {
        height: 100vh;
        background-color: #f8f8f8cc;
        color: var(--secondary-color);
    }
    .app-header.is-open .mobile-nav {
        display: flex;
    }

    @media screen and (max-width: 800px) {
        .app-header {
            padding: 23.5px 20px;
            height: var(--mobile-header-height);
        }
        .desktop-nav,
        .inst-link {
            display: none;
        }
        .burger-btn {
            display: flex;
        }
    }
</style>
